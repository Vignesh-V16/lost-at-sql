# ── LOST AT SQL backend configuration ──────────────────────────────────────────
# Copy this file to server/.env and adjust. Never commit server/.env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local instance or Atlas)
# Local MongoDB, or a MongoDB Atlas cloud cluster.
#   local : mongodb://127.0.0.1:27017/lost_at_sql
#   atlas : mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lost_at_sql?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lost_at_sql

# JWT signing secret — at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Access tokens are short-lived; the browser silently refreshes them with a rotating refresh token.
JWT_EXPIRES_IN=1h
REFRESH_TTL_HOURS=12
# Set to 1 when the site is served over HTTPS (marks the refresh cookie Secure)
COOKIE_SECURE=0

# Comma-separated list of allowed browser origins (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Coordinator account created on first start / seed
SEED_COORDINATOR_ID=coordinator
SEED_COORDINATOR_CODE=BLACK-CIPHER-2045

# SQL engine limits
QUERY_TIMEOUT_MS=4000
QUERY_MAX_ROWS=500
# Passive evidence is only extracted from focused result sets (≤ this many rows)
EVIDENCE_MAX_ROWS=20
# SQL sandbox worker threads (default: min(4, CPU cores))
# SQL_POOL_SIZE=4

# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…)
TRUST_PROXY=0

# Set to 1 to serve the built client (client/dist) from this process in production
SERVE_CLIENT=0

# Optional: debug | info | warn | error
LOG_LEVEL=info
