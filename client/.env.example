# Optional. In development the Vite dev server proxies /api and /socket.io to
# http://localhost:5000, so nothing needs to be set.
#
# For a production build served from a different origin than the API, point
# these at the backend:
# VITE_API_BASE=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
